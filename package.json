  "scripts": {
    "compile": "tsc -p . && npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --minify-syntax",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test out/test/",
    "test:e2e": "npm run compile && node scripts/e2e.js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile",
    "test:dnd": "npm run compile && node scripts/dnd-test.mjs"
  },
